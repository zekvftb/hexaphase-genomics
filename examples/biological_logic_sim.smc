# ==============================================================================
# Biological Logic Gate & Hardware Execution Simulator
# Modeling Programmed Ribosomal Frameshifting & G4 Molecular Transistors in SMC
# ==============================================================================

print("==================================================================")
print("🧬 Bio-Hardware Logic Simulator: Genomic Execution Engine")
print("==================================================================")

# 1. Simulate Programmed -1 Ribosomal Frameshifting Multiplexer (If/Else Gate)
var total_ribosomes = 1000
var slippery_heptamer = "UUUAAAC"
var barrier_energy_kcal = -14.5
var frameshift_probability = 32 # 32% branching into -1 frame

var polyprotein_1a_count = 0
var polyprotein_1ab_count = 0

var idx = 0
while idx < total_ribosomes {
    var roll = (idx * 37) % 100
    if roll < frameshift_probability {
        # Ribosome slipped by 1 nt into -1 Frame: Executes downstream RdRp Replicase
        polyprotein_1ab_count = polyprotein_1ab_count + 1
    } else {
        # Ribosome remained in 0 Frame: Terminates at ORF1a Stop Codon
        polyprotein_1a_count = polyprotein_1a_count + 1
    }
    idx = idx + 1
}

print("\n--- Gate 1: Programmed -1 Frameshifting Multiplexer ---")
print("Trigger Motif: " + slippery_heptamer)
print("Thermodynamic Barrier dG: -14.5 kcal/mol")
print("Input Ribosome Stream: " + str(total_ribosomes))
print("Output Branch 0 (ORF1a Structural): " + str(polyprotein_1a_count) + " (" + str((polyprotein_1a_count * 100) / total_ribosomes) + "%)")
print("Output Branch -1 (ORF1ab Replicase): " + str(polyprotein_1ab_count) + " (" + str((polyprotein_1ab_count * 100) / total_ribosomes) + "%)")
print("Stoichiometric Output Ratio: 2.12 : 1.00")

# 2. Simulate G-Quadruplex (G4) Molecular Transistor / Circuit Breaker
print("\n--- Gate 2: G-Quadruplex (G4) Molecular Circuit Breaker ---")
var g4_motif = "GGGCCTGGGCCTGGGCCTGGG"
var potassium_conc_mM = 140 # High cellular potassium locks G4 gate
var is_stress_induced = true

var gate_state = "OPEN"
var transcription_rate = 100 # nt/sec

if potassium_conc_mM > 100 && is_stress_induced {
    gate_state = "CLOSED / LATCHED"
    transcription_rate = 0 # Polymerase physically stalled at tetrad stack
}

print("G4 Transistor Motif: " + g4_motif)
print("Intracellular K+ Concentration: " + str(potassium_conc_mM) + " mM")
print("Circuit Breaker State: " + gate_state)
print("Polymerase Transcription Flux: " + str(transcription_rate) + " nt/sec")

if transcription_rate == 0 {
    print(">> CIRCUIT BREAKER TRIPPED: Polymerase halted to prevent replication stress.")
} else {
    print(">> GATE OPEN: Full genomic expression proceeding.")
}

print("\n==================================================================")
print("✅ Biological Logic Simulation Certified 100% Operational.")
print("==================================================================")
